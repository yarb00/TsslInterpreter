#!/usr/bin/env tssl

# https://tssl.yarb00.dev

!TooSimpleScriptingLanguage 0.7

# Lines starting with "#" are comments. They are ignored by the interpreter.
# "!TooSimpleScriptingLanguage VERSION" is a language version declaration. It must be present once, and only once, before any non-comment instruction.
# "COMMAND NAME>" or "my COMMAND NAME>" is a command call without arguments.
# "COMMAND NAME> arg1; arg2; ...; argN;" or "my COMMAND NAME> arg1; arg2; ...; argN;" is a command call with arguments.

# Too Simple Scripting Language is indentation insensetive. All lines are trimmed before parsing.
# Instructions are separated by line breaks. Line breaks DO matter.

# Valid characters for identifiers (variables, commands, labels): [A-Za-z0-9_ ] (latin letters, numbers, underscores and spaces).
# Identifiers are case insensetive. They are also trimmed before processing.

# Built-in commands are called directly by their name, while user-defined commands must be prefixed with "my".
# Variables starting with an underscore are built-in. User-defined variables cannot start with an underscore.

# Backslashes are escaped as "\\". Semicolons are escaped as "\;". String interpolation syntax is "\(VARIABLE NAME)".
# String interpolation can be nested.
# If variable "arr 2" is set to "hi", and variable "i" is set to "2", then "\(arr \(i))" is unwrapped as: "\(arr \(i))" => "\(arr 2)" => "hi".

# Traditional GOTO exists in a form of labels, which are defined on their own line as "@LABEL NAME", and the "jump> LABEL NAME;" command.
# Before script is executed, it's prescanned for labels, so you can safely jump to a label that is defined below the current line.

# User-defined commands, unlike built-in commands, are just glorified GOTOs, and passed arguments (if any) are written to variables "_1", "_2", "_3", etc.
# The total argument count is written to "_argument_count" (equals "0" if no arguments are passed).
# Fallthrough is not allowed: user-defined commands must call "stop>", "stop> MESSAGE;", "jump> LABEL NAME;" or another user-defined command before they end ("end command>").

# Define a command named "main menu".
command> main menu;
	# Print the passed string to STDOUT as it is (without a line break). "[whoami/greet/exit]: ".
	print> [whoami/greet/exit]: ;
	# Read a line from STDIN and save it to the variable named "option".
	ask line> option;
	# Trim the value of "option" and save it back.
	trim whitespace> \(option); option;

	# If value of "option" is "whoami", call the "display user" command.
	if equals> \(option); whoami;
		my display user>
	end if>

	# If value of "option" is "greet", call the "greet" command.
	if equals> \(option); greet;
		my greet>
	end if>

	# If value of "option" is "exit", exit.
	if equals> \(option); exit;
		stop>
	end if>

	# Otherwise, ask again.
	my main menu>
end command>

# Define a command named "display user".
command> display user;
	# Run the "whoami" system executable and pause execution of the script until it exits.
	execute wait> whoami;

	# If "whoami" exited with a non-zero code, let user know.
	if not equals> \(_last_execute_status); 0;
		print line> An error occurred (code: \(_last_execute_status)).;
	end if>

	# Then ask for the input again.
	my main menu>
end command>

command> greet;
	print> Your name: ;
	ask line> name;
	print line> \(name), hi!;
	my main menu>
end command>

print line> Hi! I'm a script that uses TSSL v0.7!;
# The "print line" command called without arguments prints an empty line.
print line>

# Start the main loop.
my main menu>
