#!/usr/bin/env tssl

!TooSimpleScriptingLanguage 0.7

# https://tssl.yarb00.dev

# There are no native arrays in TSSL, only flat variables.
# But we can use nested string interpolation to emulate arrays.

# Create the "array".
# Since arrays are not built-in, you can implement them in any way you want, starting with 0, 1, or any other number, or even a string (for dictionaries).
# In this example, we'll make an array that starts with index 0.
set> name 0; Alice;
set> name 1; John Doe;
set> name 2; Jane Doe;

# Iterate over the elements in a loop.
# The output:
# Hi, Alice!
# Hi, John Doe!
# Hi, Jane Doe!
set> i; 0;
while exists> name \(i);
	set> current name; \(name \(i));
	print line> Hi, \(current name)!;
	add> \(i); 1; i;
end while>

# Delete the variables from the previous loop to not reuse them accidently.
unset> current name;
unset> i;

# Let's find the length of the array.
set> length; 0;
while exists> name \(length);
	add> \(length); 1; i;
end while>

# And add a new element.
set> name \(length); Bob;
unset> length;

# The output:
# Hi, Alice!
# Hi, John Doe!
# Hi, Jane Doe!
# Hi, Bob!
set> i; 0;
while exists> name \(i);
	print line> Hi, \(name \(i))!;
	add> \(i); 1; i;
end while>
