<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>TSSL::Interpreter</AssemblyTitle>
    <Copyright>Copyright (c) 2025-2026 yarb00</Copyright>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <Product>TSSL::Interpreter</Product>
    <PublishAot>true</PublishAot>
    <RootNamespace>TsslInterpreter</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>0.6.1</VersionPrefix>
  </PropertyGroup>
</Project>
