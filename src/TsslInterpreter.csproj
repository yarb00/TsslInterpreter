<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>TSSL::Interpreter</AssemblyTitle>
    <Copyright>yarb00 (https://www.yarb00.dev)</Copyright>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <Product>TSSL::Interpreter</Product>
    <PublishAot>true</PublishAot>
    <RootNamespace>TsslInterpreter</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>0.7.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>
  <ItemGroup>
    <Content CopyToOutputDirectory="PreserveNewest" Include="$(RepositoryRoot)LICENSE.txt" />
  </ItemGroup>
</Project>
